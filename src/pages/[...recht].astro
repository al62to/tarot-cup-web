---
// Rechtsseiten in der gültigen Fassung: /datenschutz/, /nutzungsbedingungen/, /tr/gizlilik/, /tr/kullanim-kosullari/
// und die Gegenstücke der anderen Sprachen (Verzeichnis aus src/inhalte/recht/verzeichnis.json). Seiten einzelner
// Fassungen (/<text>/<nummer>/) gibt es seit AP-40D nicht mehr.
import Rechtsseite from '../components/Rechtsseite.astro';
import { rechtsseiten } from '../daten/recht.mjs';

export function getStaticPaths() {
  return rechtsseiten().map((rechtsseite) => ({
    params: { recht: rechtsseite.adresse.replace(/^\/|\/$/g, '') },
    props: { rechtsseite },
  }));
}
const { rechtsseite } = Astro.props;
---
<Rechtsseite rechtsseite={rechtsseite} />
