---
// Erklärseiten (AP-25) in allen Sprachen, für die es Adresse und Text gibt (src/daten/erklaer.mjs, src/daten/seiten.mjs),
// und die Übersicht /wissen/ (AP-25E) in den Sprachen mit mindestens einer solchen Seite.
import Erklaerseite from '../components/Erklaerseite.astro';
import Wissensuebersicht from '../components/Wissensuebersicht.astro';
import { SEITEN } from '../daten/seiten.mjs';

export function getStaticPaths() {
  return SEITEN.filter((eintrag) => eintrag.erklaer || eintrag.schluessel === 'wissen').map((eintrag) => ({
    params: { wissen: eintrag.pfad.replace(/^\/|\/$/g, '') },
    props: { schluessel: eintrag.schluessel, sprache: eintrag.sprache },
  }));
}
const { schluessel, sprache } = Astro.props;
---
{schluessel === 'wissen' ? <Wissensuebersicht sprache={sprache} /> : <Erklaerseite schluessel={schluessel} sprache={sprache} />}
