---
// Kurzlink /app/ (Muster [kurzlink] von FoodAsu, Auftrag Teil F). Ist die App öffentlich, schickt ein kleines eigenes
// Skript Android-Geräte sofort zum Eintrag bei Google Play (Kennung utm_source=website, utm_campaign=kurzlink); am
// Computer bleibt diese Seite mit Abzeichen und QR-Code stehen (QR beim Bau lokal erzeugt, er führt wieder auf
// /app/). iPhone und iPad bleiben auf der Seite und lesen, dass es Tarot Cup nur für Android gibt. Solange die App
// nicht öffentlich ist, steht hier nur „Bald bei Google Play“. Die Seite gilt für alle Sprachen (Deutsch, Türkisch,
// Englisch, Spanisch, AP-SPR2); jeder Teil außer dem deutschen trägt lang, das Abzeichen und der Link je Teil die
// Sprache des Teils. Die Weiterleitung für Android nimmt den Link ohne Sprache (Google Play wählt die Sprache des Geräts).
// noindex, nicht in Sitemap und llms.txt. Nichts wird gespeichert, nichts von anderen Anbietern geladen.
import QRCode from 'qrcode';
import '../../styles/dokument.css';
import Basis from '../../layouts/Basis.astro';
import Storeknopf from '../../components/Storeknopf.astro';
import Text from '../../components/Text.astro';
import { seite, store, storeLink } from '../../daten/seite.mjs';
import { oberflaeche } from '../../daten/texte/oberflaeche.mjs';
import { SPRACHEN } from '../../daten/adressen.mjs';

const ziel = store.oeffentlich ? storeLink('kurzlink') : null;
const qr = store.oeffentlich
  ? await QRCode.toString(`${seite.adresse}/app/`, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#12162B', light: '#FFFDF8' } })
  : null;
const weiter = { android: ziel };
---
<Basis klasse="seite-app">
  <div class="innen schmal app-seite">
    {SPRACHEN.map((sprache) => {
      const T = oberflaeche[sprache].app;
      return (
        <section class="app-teil" lang={sprache === 'de' ? undefined : sprache}>
          {sprache === 'de' ? <h1><Text text={T.titel} ohne /></h1> : <h2><Text text={T.titel} ohne /></h2>}
          {store.oeffentlich ? (
            <>
              <Text text={T.text} />
              <Storeknopf sprache={sprache} ort="kurzlink" />
              <p><a href={storeLink('kurzlink', sprache)} rel="noopener">{T.weiter}</a></p>
            </>
          ) : (
            <>
              <Text text={T.bald} />
              <Storeknopf sprache={sprache} ort="kurzlink" />
            </>
          )}
          <Text text={T.iphone} klasse="app-iphone" />
        </section>
      );
    })}
    {qr && (
      <figure class="app-qr">
        <Fragment set:html={qr} />
        <figcaption>{oberflaeche.de.app.qr}{SPRACHEN.filter((sprache) => sprache !== 'de').map((sprache) => <> · <span lang={sprache}>{oberflaeche[sprache].app.qr}</span></>)}</figcaption>
      </figure>
    )}
  </div>
  {weiter.android && (
    <script type="application/json" id="app-weiter" set:html={JSON.stringify(weiter)} />
  )}
</Basis>

<script>
  // Weiterleitung nur für Android und nur, wenn die Seite ein Ziel nennt (App öffentlich). Erkennung allein am
  // User-Agent, nichts wird gespeichert oder gesendet.
  const daten = document.getElementById('app-weiter');
  if (daten) {
    try {
      const { android } = JSON.parse(daten.textContent);
      const kennung = navigator.userAgent;
      if (android && /Android/i.test(kennung)) window.location.replace(android);
    } catch {
      // Die Seite mit den Links bleibt stehen.
    }
  }
</script>
