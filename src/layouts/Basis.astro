---
// Grundlayout aller Seiten: Kopfdaten (Titel, Beschreibung, kanonische Adresse, Robots, hreflang, Open Graph,
// strukturierte Daten), Kopf, Brotkrumen auf Unterseiten, Inhalt, Fuß (mit dem Teilen-Knopf auf Inhaltsseiten).
// Alle Angaben kommen über die Adresse aus src/daten/seiten.mjs; eine Seite gibt sie nicht selbst an.
// Keine Cookies, keine Anfragen an andere Anbieter. Das Skript im Kopf setzt die Klasse "js" (Gestaltung mit
// JavaScript, etwa das Menü am Handy) und schaltet die Sprach-Hinweisleiste (Auftrag W5, components/Sprachhinweis.astro)
// ein. Gespeichert wird im Browser nur, für welche Sprache die Leiste geschlossen wurde (localStorage, ein Schlüssel).
import '../styles/schriften.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/basis.css';
import interLatein from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
// Schrift der großen Titelzeile der Startseite (Cormorant 500, normal und kursiv, Bereich latin): vorab laden, damit die
// Zeile nicht erst in der Ersatzschrift erscheint und dann springt (Lighthouse, Verschiebung des Layouts).
import titelNormal from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import titelKursiv from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import Brotkrumen from '../components/Brotkrumen.astro';
import Sprachhinweis from '../components/Sprachhinweis.astro';
import { seite } from '../daten/seite.mjs';
import { seiteVon } from '../daten/seiten.mjs';
import { OG_LOCALE, OG_LOCALE_ZUSATZ, STANDARD_SPRACHE } from '../daten/adressen.mjs';
import { oberflaeche } from '../daten/texte/oberflaeche.mjs';
import { websiteDaten, herausgeberDaten, jsonLd } from '../daten/strukturiert.mjs';

const { adresse = Astro.url.pathname, daten = [], klasse } = Astro.props;
const angaben = seiteVon(adresse);
const { sprache, titel, beschreibung, fassungen, krumen, bild, bildAlt, art, imIndex, teilen } = angaben;
const T = oberflaeche[sprache];
const kanonisch = seite.adresse + angaben.pfad;
// hreflang (AP-SPR2): alle Sprachfassungen der Seite, die Seite selbst zuerst, nur Sprachcodes. x-default zeigt auf die
// englische Fassung; gibt es keine (Archiv der Rechtstexte, nur de und tr), auf die deutsche wie bisher.
const standard = fassungen?.find((fassung) => fassung.sprache === STANDARD_SPRACHE) ?? fassungen?.find((fassung) => fassung.sprache === 'de');
const alternativen = fassungen
  ? [
      { lang: sprache, href: kanonisch },
      ...fassungen.filter((fassung) => fassung.sprache !== sprache).map((fassung) => ({ lang: fassung.sprache, href: seite.adresse + fassung.pfad })),
      { lang: 'x-default', href: seite.adresse + standard.pfad },
    ]
  : [];
// Open Graph: Sprache der Seite und die Sprachen der übrigen Fassungen (Deutsch dazu de_AT wie bisher).
const ogLocale = OG_LOCALE[sprache];
const ogAlternativ = [...(OG_LOCALE_ZUSATZ[sprache] ?? []), ...(fassungen ?? []).filter((fassung) => fassung.sprache !== sprache).map((fassung) => OG_LOCALE[fassung.sprache])];
const robots = imIndex ? null : angaben.index ? 'noindex, nofollow' : 'noindex, follow';
const alleDaten = [websiteDaten(sprache), herausgeberDaten(), ...daten];
// Sprach-Hinweisleiste: die übrigen Sprachfassungen der Seite (dieselben wie in hreflang). Ohne Fassungen keine Leiste.
const hinweisZiele = (fassungen ?? []).filter((fassung) => fassung.sprache !== sprache);
---
<!doctype html>
<html lang={sprache} data-fassungen={hinweisZiele.map((ziel) => ziel.sprache).join(' ') || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Sprach-Hinweisleiste: erste Browsersprache, wenn es die Seite in ihr gibt und sie nicht die Sprache der Seite
        // ist. Der Schlüssel steht auch in src/daten/sprachhinweis.mjs und tools/pruefe_bau.mjs.
        var fassungen = (d.getAttribute('data-fassungen') || '').split(' ');
        var erste = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        var l = String(erste).toLowerCase().split('-')[0];
        if (!l || l === d.lang || fassungen.indexOf(l) < 0) return;
        var zu = null;
        try { zu = localStorage.getItem('tarotcup-sprachhinweis'); } catch (e) {}
        if (zu === l) return;
        d.setAttribute('data-sprachhinweis', l);
        document.addEventListener('click', function (ereignis) {
          var knopf = ereignis.target && ereignis.target.closest ? ereignis.target.closest('[data-sprachhinweis-zu]') : null;
          if (!knopf) return;
          var hatteFokus = document.activeElement === knopf;
          try { localStorage.setItem('tarotcup-sprachhinweis', l); } catch (e) {}
          d.removeAttribute('data-sprachhinweis');
          var marke = document.querySelector('.marke-link');
          if (hatteFokus && marke) marke.focus();
        });
      })();
    </script>
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={kanonisch} />
    {alternativen.map((eintrag) => <link rel="alternate" hreflang={eintrag.lang} href={eintrag.href} />)}
    {robots && <meta name="robots" content={robots} />}
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1B130E" />
    <meta property="og:type" content={art} />
    <meta property="og:site_name" content={seite.name} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternativ.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={seite.adresse + bild} />
    <meta property="og:image:width" content={String(seite.teilen.breite)} />
    <meta property="og:image:height" content={String(seite.teilen.hoehe)} />
    <meta property="og:image:alt" content={bildAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatein} as="font" type="font/woff2" crossorigin />
    {klasse === 'seite-start' && [titelNormal, titelKursiv].map((datei) => <link rel="preload" href={datei} as="font" type="font/woff2" crossorigin />)}
    {alleDaten.map((eintrag) => <script type="application/ld+json" set:html={jsonLd(eintrag)} />)}
  </head>
  <body class={klasse}>
    <a class="sprung" href="#inhalt">{T.sprung}</a>
    <Sprachhinweis ziele={hinweisZiele} />
    <Kopf angaben={angaben} />
    {krumen && <Brotkrumen krumen={krumen} sprache={sprache} />}
    <main id="inhalt">
      <slot />
    </main>
    <Fuss angaben={angaben} teilen={teilen ? { titel, adresse: kanonisch } : null} />
  </body>
</html>
