---
// Block mit Links auf Erklärseiten und Themenseiten (AP-25), ruhig und ohne Bilder. Zwei Formen:
//   eintraege: Karten mit Titel und kurzer Beschreibung („Weiterlesen“ auf den Erklärseiten, „Mehr zum Thema“ auf den
//              Ratgebern Tarot und Kaffeesatz);
//   gruppen:   Spalten je Bereich mit schlichten Links (Startseite).
// "alle" ({ text, ziel }, AP-25E): Link am Ende des Blocks (Startseite „Alle Seiten“ auf die Übersicht, Übersicht der
// Link auf den Ratgeber des Bereichs). Listen aus src/daten/wissen.mjs; ohne Einträge zeichnet der Block nichts. Stile in src/styles/wissen.css (nur auf den
// Seiten, die den Block einsetzen; /app/ lädt ihn nie).
import '../styles/wissen.css';
import Betont from './Betont.astro';

const { titel, kennung, eintraege = [], gruppen = [], bereichNamen = {}, klasse, titelKlasse, alle = null } = Astro.props;
if (!kennung) throw new Error('Wissensblock: kennung fehlt');
const leer = !eintraege.length && !gruppen.length;
---
{!leer && (
  <section class:list={['wissen', klasse]} id={kennung} aria-labelledby={`${kennung}-titel`}>
    <h2 id={`${kennung}-titel`} class={titelKlasse}><Betont text={titel} /></h2>
    {eintraege.length > 0 && (
      <ul class="wissen-karten">
        {eintraege.map((eintrag) => (
          <li>
            <a class="wissen-karte" href={eintrag.pfad}>
              <span class="wissen-karte-titel"><Betont text={eintrag.titel} /></span>
              <span class="wissen-karte-text">{eintrag.text}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    {gruppen.length > 0 && (
      <div class="wissen-gruppen">
        {gruppen.map((gruppe) => (
          <div class:list={['wissen-gruppe', `wissen-gruppe-${gruppe.bereich}`]}>
            <h3 class="wissen-gruppe-titel">{bereichNamen[gruppe.bereich]}</h3>
            <ul class="wissen-liste">
              {gruppe.eintraege.map((eintrag) => <li><a class="wissen-link" href={eintrag.pfad}><span><Betont text={eintrag.titel} /></span></a></li>)}
            </ul>
          </div>
        ))}
      </div>
    )}
    {alle && <div class="wissen-alle"><a class="pfeil-link" href={alle.ziel}>{alle.text}</a></div>}
  </section>
)}
