---
// Gerüst der Rechtstexte (Muster Rechtsseite.astro von FoodAsu): Datenschutzerklärung und Nutzungsbedingungen in der
// gültigen Fassung. Inhalt: Link zur anderen Sprache, dann der Text. Seit AP-40D (Entscheidung Ali, 19.11.2026) keine
// Liste der Fassungen und keine Seiten älterer Fassungen mehr. Am Wortlaut ändert das Gerüst nichts: Der Text kommt als
// Baustein aus src/inhalte/recht/ (deutung-unterlagen/arbeit/recht_web.py) und steht in einem Element mit
// data-rechtstext; die Wortprüfungen des Baus nehmen genau diesen Teil aus.
// Übersetzungen ohne Gegenstück (Englisch, Spanisch und die übrigen Sprachen, AP-SPR2): oben die Links zu den
// maßgeblichen Fassungen auf Deutsch und Türkisch.
import '../styles/dokument.css';
import Basis from '../layouts/Basis.astro';
import { bausteinVon, sprachwahl } from '../daten/recht.mjs';

const { rechtsseite } = Astro.props;
const { fassung } = rechtsseite;
const { link: wahl, links = [] } = sprachwahl(rechtsseite);
---
<Basis adresse={rechtsseite.adresse} klasse="seite-recht">
  <div class="innen recht">
    {wahl && <p class="sprachwahl-recht"><a href={wahl.ziel} hreflang={wahl.sprache}><span lang={wahl.sprache}>{wahl.text}</span></a></p>}
    {links.length > 0 && <p class="sprachwahl-recht">{links.map((eintrag, nummer) => <>{nummer > 0 && ' '}<a href={eintrag.ziel} hreflang={eintrag.sprache}><span lang={eintrag.sprache}>{eintrag.text}</span></a></>)}</p>}
    <div class="rechtstext" data-rechtstext set:html={bausteinVon(fassung)} />
  </div>
</Basis>
