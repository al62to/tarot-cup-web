---
// Karte zum Umdrehen (Entwurf 9.1, design/reihe9/WebNeu.dc.html; bis AP-28 rechts im Titelbild, seit AP-28 im Abschnitt
// „Was ist Tarot Cup?“, weil im Titelbild jetzt die beiden Figuren stehen). Zwei gefächerte Kartenrückseiten vor
// langsam drehenden goldenen Ringen, davor die Karte zum Umdrehen. Mit JavaScript wird sie zum Knopf: Antippen dreht
// sie um (3D-Drehung, bei reduzierter Bewegung ohne Drehung) und zeigt eine Originalkarte aus TITELKARTEN, zuerst den
// Magier; nochmal antippen dreht sie zurück, danach kommt die nächste.
// Die nächste Karte wird vorgeladen und erst getauscht, wenn sie dekodiert ist (kein Aufblitzen, AP-W6).
// Darunter (aria-live) vorher der Tipp, danach Name und Hinweis aufs Lexikon. Keine Deutung, nichts wird gespeichert.
// Ohne JavaScript steht die Vorderseite des Magiers als Bild da, ohne Knopf und ohne Tipp.
// Liegt nicht mehr im ersten Bildschirm: Mit JavaScript lädt die Vorderseite erst, wenn die Karte in die Nähe des
// Fensters kommt (oder beim ersten Antippen), damit sie beim Laden der Seite nicht mit den Figuren im Titelbild um die
// Leitung konkurriert. Ohne JavaScript steht der Magier als normales Bild (loading="lazy") im noscript.
import Kartenbild from './Kartenbild.astro';
import { GESPERRT, TITELKARTEN } from '../daten/karten.mjs';
import appDaten from '../daten/app_daten.json' with { type: 'json' };
import { oberflaeche } from '../daten/texte/oberflaeche.mjs';

const { sprache, karte } = Astro.props;
const name = (id) => appDaten.karten.find((eintrag) => eintrag.id === id).name[sprache];
const jahr = oberflaeche[sprache].bilder.druck1909;
// Zuerst der Magier, dann die übrigen Titelkarten; gesperrte Bilder nie (Kartenbild.astro prüft das zusätzlich).
const ERSTE = 'ta_01_magier';
const reihe = [ERSTE, ...TITELKARTEN.filter((id) => id !== ERSTE)].filter((id) => !GESPERRT.includes(id));
const GROESSEN = '(min-width: 64rem) 220px, 48vw';
const karten = reihe.map((id) => ({ name: name(id), alt: `${name(id)}, ${jahr}`, klein: `/bilder/karten/${id}-240.webp`, gross: `/bilder/karten/${id}-480.webp` }));
---
<div class="titel-karten">
  <div class="stapel">
    <div class="stapel-schein" aria-hidden="true"></div>
    <svg class="stapel-ringe" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
      <circle cx="210" cy="210" r="200" /><circle cx="210" cy="210" r="180" stroke-dasharray="1 8" /><path d="M210 4v18M210 398v18M4 210h18M398 210h18" />
    </svg>
    <div class="stapel-hinten stapel-hinten-1" aria-hidden="true"></div>
    <div class="stapel-hinten stapel-hinten-2" aria-hidden="true"></div>
    <div
      class="wende"
      data-karte
      data-karten={JSON.stringify(karten)}
      data-tipp={karte.tipp}
      data-satz={karte.satz}
      data-umdrehen={karte.umdrehen}
      data-zurueck={karte.zurueck}
    >
      <span class="wende-dreh">
        <span class="wende-seite wende-rueck" aria-hidden="true">
          <svg viewBox="0 0 120 120" focusable="false"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="44" stroke-dasharray="1 5" /><circle cx="60" cy="60" r="30" /><path d="M60 2v14M60 104v14M2 60h14M104 60h14" /><path d="M47 55h26v8a13 13 0 0 1-26 0z" /><path d="M73 57h3a4 4 0 0 1 0 8h-3" /></svg>
        </span>
        <span class="wende-seite wende-vorn">
          <img class="kartenbild wende-bild" data-spaet-src={karten[0].gross} data-spaet-srcset={`${karten[0].klein} 240w, ${karten[0].gross} 480w`} sizes={GROESSEN} width="480" height="822" alt={karten[0].alt} decoding="async" />
          <noscript><Kartenbild id={ERSTE} alt={karten[0].alt} klasse="wende-bild" groessen={GROESSEN} /></noscript>
        </span>
      </span>
    </div>
  </div>
  <p class="wende-text nur-js" aria-live="polite">
    <span class="wende-name" data-karte-name></span>
    <span class="wende-satz" data-karte-satz>{karte.tipp}</span>
  </p>
</div>

<script>
  // Karte zum Umdrehen: Aus der Hülle wird ein echter Knopf (ohne JavaScript bleibt sie ein Bild). Der Zustand lebt
  // nur in der Klasse "offen" und im aria-label; nichts wird gespeichert.
  const huelle = document.querySelector('[data-karte]');
  if (huelle instanceof HTMLElement) {
    const angaben = { ...huelle.dataset };
    const karten = JSON.parse(angaben.karten ?? '[]');
    const knopf = document.createElement('button');
    knopf.type = 'button';
    knopf.className = huelle.className;
    knopf.append(...huelle.childNodes);
    huelle.replaceWith(knopf);
    const dreh = knopf.querySelector('.wende-dreh');
    const bild = knopf.querySelector('img');
    const name = document.querySelector('[data-karte-name]');
    const satz = document.querySelector('[data-karte-satz]');
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Vorderseite erst nahe am Fenster laden (oder beim ersten Antippen), siehe Kopf der Datei.
    let spaetFertig = Promise.resolve();
    const spaetLaden = () => {
      if (!bild || !bild.dataset.spaetSrc) return spaetFertig;
      bild.srcset = bild.dataset.spaetSrcset ?? '';
      bild.src = bild.dataset.spaetSrc;
      delete bild.dataset.spaetSrc;
      delete bild.dataset.spaetSrcset;
      try { spaetFertig = bild.decode().catch(() => {}); } catch { /* alter Browser: ohne Warten */ }
      return spaetFertig;
    };
    if (bild?.dataset.spaetSrc) {
      if ('IntersectionObserver' in window) {
        const beobachter = new IntersectionObserver((eintraege) => {
          if (eintraege.some((eintrag) => eintrag.isIntersecting)) { beobachter.disconnect(); spaetLaden(); }
        }, { rootMargin: '400px 0px' });
        beobachter.observe(knopf);
      } else {
        spaetLaden();
      }
    }
    let nummer = 0;
    let offen = false;
    let wechsel = false;
    let tausch = null;
    let wartet = false;
    const warte = (ms) => new Promise((weiter) => setTimeout(weiter, ms));
    const quellen = (karte) => `${karte.klein} 240w, ${karte.gross} 480w`;
    // Vorladen: Ist eine Karte aufgedeckt, lädt und dekodiert ein unsichtbares Bild die eine nächste Karte (gleiche
    // srcset und sizes wie das echte Bild, also dieselbe Datei). Nie mehr als diese eine. Kann der Browser decode()
    // nicht, wird still wie bisher getauscht.
    let vorrat = null;
    const vorladen = () => {
      const folgende = (nummer + 1) % karten.length;
      if (!bild || karten.length < 2 || vorrat?.nummer === folgende) return;
      const karte = karten[folgende];
      const probe = new Image();
      probe.decoding = 'async';
      probe.sizes = bild.sizes;
      probe.srcset = quellen(karte);
      probe.src = karte.gross;
      let fertig = Promise.resolve();
      try { fertig = probe.decode().catch(() => {}); } catch { /* alter Browser: ohne Warten tauschen */ }
      vorrat = { nummer: folgende, fertig, probe };
    };
    // Nächste Karte einsetzen, sobald die Rückseite wieder vorn ist: erst wenn das Vorladen fertig ist, höchstens
    // etwa 300 ms darauf warten. Danach noch kurz warten, bis das echte Bild dekodiert ist, damit beim Umdrehen nie die
    // alte Karte oder ein leeres Bild aufblitzt (höchstens 2,5 Sekunden, damit der Knopf nie hängt).
    const naechste = () => {
      if (!wechsel || !bild) return tausch;
      wechsel = false;
      const lauf = (async () => {
        vorladen();
        // Wurde während des Zurückdrehens getippt, erst warten, bis die Rückseite ganz vorn ist.
        const laeuft = dreh?.getAnimations?.() ?? [];
        await Promise.race([Promise.all(laeuft.map((animation) => animation.finished.catch(() => {}))), warte(1000)]);
        await Promise.race([vorrat?.fertig ?? Promise.resolve(), warte(300)]);
        nummer = (nummer + 1) % karten.length;
        const karte = karten[nummer];
        bild.srcset = quellen(karte);
        bild.src = karte.gross;
        bild.alt = karte.alt;
        vorrat = null;
        try { await Promise.race([bild.decode().catch(() => {}), warte(2500)]); } catch { /* wie bisher */ }
      })();
      tausch = lauf;
      lauf.then(() => { if (tausch === lauf) tausch = null; });
      return lauf;
    };
    const zeige = () => {
      const karte = karten[nummer];
      knopf.classList.toggle('offen', offen);
      knopf.setAttribute('aria-label', offen ? angaben.zurueck.replace('{name}', karte.name) : angaben.umdrehen);
      if (name) name.textContent = offen ? karte.name : '';
      if (satz) satz.textContent = offen ? angaben.satz : angaben.tipp;
    };
    dreh?.addEventListener('transitionend', (ereignis) => {
      if (ereignis.target === dreh && !offen) naechste();
    });
    knopf.addEventListener('click', async () => {
      if (wartet) return;
      // Vorderseite noch nicht geladen (sehr schnelles Antippen): kurz darauf warten, höchstens 2,5 Sekunden.
      if (!offen && bild?.dataset.spaetSrc) {
        wartet = true;
        await Promise.race([spaetLaden(), warte(2500)]);
        wartet = false;
      }
      // Erst umdrehen, wenn der Tausch erledigt ist.
      if (!offen && (wechsel || tausch)) {
        wartet = true;
        knopf.setAttribute('aria-busy', 'true');
        await naechste();
        knopf.removeAttribute('aria-busy');
        wartet = false;
      }
      offen = !offen;
      if (!offen) wechsel = true;
      zeige();
      if (offen) vorladen();
      if (!offen && (ruhig.matches || !dreh || getComputedStyle(dreh).transitionDuration === '0s')) naechste();
    });
    zeige();
  }
</script>
