---
// Startseite in einer Sprache nach Entwurf 9.1 (design/reihe9/WebNeu.dc.html, Auftrag AP-W2): Titelbild mit Karte zum
// Umdrehen und Zahlenband (Titelbild.astro), „Was ist Tarot Cup?“ (Pflicht, im Entwurf nicht zu sehen), das Ritual mit
// der Tassenkarte zum Antippen, der Schaukasten mit einem Handy (Schaukasten.astro), „Was die App kann“ als
// Kachelraster, zwei Ratgeber-Kacheln (Bild oben in eigenem Bereich, Text darunter, nie überlappend) und häufige
// Fragen mit Trennlinien. Der Hinweis „Zur Unterhaltung …“ steht seit AP-W2 im Fuß jeder Seite.
// Hervorhebungen (*…*) in Überschriften kommen aus den Textdaten (Betont.astro).
import '../styles/start.css';
import Basis from '../layouts/Basis.astro';
import Betont from './Betont.astro';
import Kartenbild from './Kartenbild.astro';
import Schaukasten from './Schaukasten.astro';
import Tassenkarte from './Tassenkarte.astro';
import Text from './Text.astro';
import Titelbild from './Titelbild.astro';
import { start } from '../daten/texte/start.mjs';
import { fragen } from '../daten/texte/fragen.mjs';
import { pfadVon } from '../daten/seiten.mjs';
import { appDaten, faqDaten } from '../daten/strukturiert.mjs';
import { FOTOS_START, fotoPfad } from '../daten/fotos.mjs';

const { sprache } = Astro.props;
const T = start[sprache];
const auszug = T.fragen.ids.map((id) => {
  const eintrag = fragen[sprache].liste.find((frage) => frage.id === id);
  if (!eintrag) throw new Error(`Startseite: Frage ${id} fehlt in fragen.mjs`);
  return eintrag;
});
const pfad = pfadVon('start', sprache);
const daten = [
  appDaten({ beschreibung: T.wasIst.text, bildschirmfotos: FOTOS_START.map((name) => fotoPfad('app', name, sprache, 720)) }),
  faqDaten({ pfad, sprache, liste: auszug }),
];
const vorteil = (id) => {
  const eintrag = T.vorteile.find((kandidat) => kandidat.id === id);
  if (!eintrag) throw new Error(`Startseite: Vorteil ${id} fehlt in start.mjs`);
  return eintrag;
};
const [sprachLinks, sprachRechts] = T.koennen.sprachen.gross.split('/').map((teil) => teil.trim());
const istTarot = (ziel) => ziel === pfadVon('tarot', sprache);
// Linien-Symbole der kleinen Kacheln (Entwurf 9.1): Funkwellen durchgestrichen, Person durchgestrichen.
const SYMBOL = {
  internet: '<path d="M6 15a20 20 0 0 1 28 0M10 20a14 14 0 0 1 20 0M14.5 25a8 8 0 0 1 11 0"/><circle cx="20" cy="30" r="1.6" class="voll"/><path d="M5 35L35 5"/>',
  konto: '<circle cx="20" cy="14" r="6"/><path d="M8 34a12 12 0 0 1 24 0"/><path d="M5 35L35 5"/>',
};
---
<Basis daten={daten} klasse="seite-start">
  <Titelbild sprache={sprache} kopf={T.kopf} zahlen={T.zahlen} />

  <section class="wasist innen" aria-labelledby="wasist-titel">
    <h2 id="wasist-titel" class="start-titel"><Betont text={T.wasIst.titel} /></h2>
    <Text text={T.wasIst.text} klasse="wasist-text" />
  </section>

  <section class="ritual innen" aria-labelledby="ritual-titel">
    <div class="ritual-text">
      <p class="start-zeile">{T.tasse.zeile}</p>
      <h2 id="ritual-titel" class="start-titel"><Betont text={T.tasse.titel} /></h2>
      <ol class="ritual-liste">
        {T.tasse.schritte.map((schritt, nummer) => (
          <li><span class="ritual-nummer" aria-hidden="true">{String(nummer + 1).padStart(2, '0')}</span><span class="ritual-schritt"><Text text={schritt} ohne /></span></li>
        ))}
      </ol>
      <p class="ritual-weiter"><a class="pfeil-link" href={T.tasse.link.ziel}>{T.tasse.link.text}</a></p>
    </div>
    <Tassenkarte sprache={sprache} bereiche={T.tassenkarte.bereiche} spiel={T.tassenkarte} />
  </section>

  <Schaukasten sprache={sprache} texte={T.schaukasten} alt={T.fotos.alt} />

  <section class="koennen innen" aria-labelledby="koennen-titel">
    <h2 id="koennen-titel" class="start-titel"><Betont text={T.koennen.titel} /></h2>
    <div class="bento">
      <article class="bento-kachel bento-gross bento-nacht flaeche-dunkel">
        <svg class="bento-schmuck" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><circle cx="50" cy="50" r="46" /><circle cx="50" cy="50" r="36" stroke-dasharray="1 4" /><path d="M38 48h24v8a12 12 0 0 1-24 0z" /><path d="M62 50h3a3.6 3.6 0 0 1 0 7.2h-3" /></svg>
        <h3>{vorteil('bleibt').titel}</h3>
        <Text text={vorteil('bleibt').text} />
      </article>
      {['internet', 'konto'].map((id) => (
        <article class="bento-kachel bento-klein bento-hell">
          <svg class="bento-symbol" viewBox="0 0 40 40" aria-hidden="true" focusable="false" set:html={SYMBOL[id]} />
          <div class="bento-unten">
            <h3>{vorteil(id).titel}</h3>
            <Text text={vorteil(id).text} />
          </div>
        </article>
      ))}
      <article class="bento-kachel bento-gross bento-sand">
        <h3>{T.koennen.ruhe.titel}</h3>
        <Text text={T.koennen.ruhe.text} />
        <ul class="bento-pillen">
          {T.koennen.ruhe.pillen.map((pille) => <li><strong>{pille.name}</strong> · {pille.takt}</li>)}
        </ul>
      </article>
      <article class="bento-kachel bento-klein bento-kupfer flaeche-dunkel">
        <p class="bento-sprachen" aria-hidden="true">{sprachLinks} <span>/</span> {sprachRechts}</p>
        <div class="bento-unten">
          <h3>{T.koennen.sprachen.titel}</h3>
          <Text text={T.koennen.sprachen.text} />
        </div>
      </article>
    </div>
  </section>

  <section class="ratgeber-teil innen" aria-labelledby="ratgeber-titel">
    <h2 id="ratgeber-titel" class="start-titel"><Betont text={T.ratgeber.titel} /></h2>
    <div class="rk-raster">
      {T.ratgeber.eintraege.map((eintrag) => (
        <a class:list={['rk', 'flaeche-dunkel', istTarot(eintrag.ziel) ? 'rk-tarot' : 'rk-kaffee']} href={eintrag.ziel}>
          {istTarot(eintrag.ziel) ? (
            <div class="rk-bild" aria-hidden="true">
              <svg class="rk-ringe" viewBox="0 0 100 100" focusable="false"><circle cx="50" cy="50" r="46" /><circle cx="50" cy="50" r="38" stroke-dasharray="1 4" /></svg>
              <Kartenbild id="ta_10_rad" alt="" klasse="rk-karte rk-karte-1" groessen="120px" />
              <Kartenbild id="ta_kel_01_ass" alt="" klasse="rk-karte rk-karte-2" groessen="120px" />
            </div>
          ) : (
            <div class="rk-bild" aria-hidden="true">
              <span class="rk-tasse">
                <svg class="rk-dampf rk-dampf-1" viewBox="0 0 100 100" focusable="false"><path d="M42 30 Q37 23 42 16 Q47 9 42 2" /></svg>
                <svg class="rk-dampf rk-dampf-2" viewBox="0 0 100 100" focusable="false"><path d="M56 30 Q51 23 56 16 Q61 9 56 2" /></svg>
                <svg class="rk-tasse-bild" viewBox="0 0 100 100" focusable="false">
                  <path d="M22 36 H78 V48 A28 22 0 0 1 22 48 Z" class="rk-porzellan" />
                  <ellipse cx="50" cy="36" rx="28" ry="5" class="rk-satz" />
                  <path d="M78 41 H84 A8.5 8.5 0 0 1 84 58 H76" class="rk-strich" />
                  <path d="M10 76 Q50 86 90 76" class="rk-strich" />
                </svg>
              </span>
            </div>
          )}
          <div class="rk-text">
            <span class="rk-zeile">{T.ratgeber.zeile}</span>
            <h3 class="rk-titel">{eintrag.titel}</h3>
            <Text text={eintrag.text} klasse="rk-absatz" />
            <span class="rk-link">{eintrag.link}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="fragen-teil" aria-labelledby="fragen-titel">
    <div class="innen fragen-raster">
      <div class="fragen-kopf">
        <h2 id="fragen-titel" class="start-titel"><Betont text={T.fragen.titel} /></h2>
        <a class="pfeil-link" href={pfadVon('fragen', sprache)}>{T.fragen.alle}</a>
      </div>
      <div class="fragen-auszug">
        {auszug.map((eintrag, nummer) => (
          <details class="frage-linie" open={nummer === 0}>
            <summary><span><Text text={eintrag.frage} ohne /></span></summary>
            {eintrag.antwort.map((absatz) => <Text text={absatz} />)}
          </details>
        ))}
      </div>
    </div>
  </section>
</Basis>
