---
// Titelbild der Startseite nach Entwurf 9.1 (design/reihe9/WebNeu.dc.html), dazu das Zahlenband auf demselben dunklen
// Grund. Espresso mit leichter Körnung (eine kleine SVG-Kachel als Hintergrund, kein großes Bild) und warmem Licht.
// Text: Zeile, große Überschrift (Hervorhebung *…* aus den Textdaten kursiv in Gold), Absatz, das offizielle Abzeichen
// von Google Play (Schalter store.oeffentlich, seit AP-21; vorher „Bald bei Google Play“ ohne Link) und der Zweitknopf
// zur Anleitung.
// Seit AP-28 steht neben dem Text die Bühne mit den beiden gezeichneten Figuren der App vor einem Nachthimmel (Nachtblau,
// ein paar goldene Sterne, nur CSS und ein kleines SVG, nie unter Text). Sie ist das wichtigste Bild der Seite: beide
// Bilder laden mit Vorrang, die Bühne hat ein festes Seitenverhältnis (kein Verschieben beim Laden). Die Karte zum
// Umdrehen, bis dahin an dieser Stelle, steht jetzt im Abschnitt „Was ist Tarot Cup?“ (Wendekarte.astro).
// Anordnung am Handy: Zeile, Überschrift, Figuren, Knöpfe, Absatz (Abzeichen im ersten Bildschirm); ab 60rem zwei
// Spalten, links Zeile, Überschrift, Absatz, Knöpfe, rechts die Figuren.
import Begleiterbild from './Begleiterbild.astro';
import Text from './Text.astro';
import Storeknopf from './Storeknopf.astro';
import { store } from '../daten/seite.mjs';
import { pfadVon } from '../daten/seiten.mjs';
import { oberflaeche } from '../daten/texte/oberflaeche.mjs';
import Betont from './Betont.astro';

const { sprache, kopf, zahlen } = Astro.props;
const bilder = oberflaeche[sprache].bilder;
// Breite einer Figur: halbe Bühne (Bühne höchstens 34rem neben dem Text, 30rem darunter).
const GROESSEN = '(min-width: 60rem) 272px, (min-width: 34rem) 240px, 46vw';
// Die Zeile steht in Großbuchstaben; „Android“ trägt lang="en", damit es auf Türkisch nicht zu „ANDROİD“ wird.
const zeileTeile = kopf.zeile.split(/(Android)/);
// Sterne der Bühne (Mittelpunkt x, y und Größe im Maß 400 x 310); die mit "funkeln" leuchten langsam auf und ab.
const stern = ([x, y, r]) => `M${x} ${y - r}L${x + r * 0.26} ${y - r * 0.26}L${x + r} ${y}L${x + r * 0.26} ${y + r * 0.26}L${x} ${y + r}L${x - r * 0.26} ${y + r * 0.26}L${x - r} ${y}L${x - r * 0.26} ${y - r * 0.26}Z`;
const STERNE = [[56, 74, 9], [200, 26, 10], [346, 70, 8], [122, 34, 5], [282, 38, 6], [26, 156, 5], [376, 168, 6], [200, 112, 5]];
const PUNKTE = [[84, 42, 1.4], [160, 64, 1.2], [242, 62, 1.3], [318, 22, 1.4], [34, 108, 1.2], [368, 118, 1.3], [152, 14, 1], [262, 100, 1]];
---
<div class="titel-welt flaeche-dunkel">
  <section class="titel" aria-labelledby="titel-ueberschrift">
    <div class="innen titel-raster">
      <p class="titel-zeile">{zeileTeile.map((teil) => (teil === 'Android' ? <span lang="en">{teil}</span> : <Text text={teil} ohne />))}</p>
      <h1 id="titel-ueberschrift">{kopf.zeilen.map((zeile) => <span class="titel-satz"><Betont text={zeile} /></span>)}</h1>
      <div class="begleiter-buehne" role="img" aria-label={bilder.begleiterBeide}>
        <svg class="buehne-sterne" viewBox="0 0 400 310" aria-hidden="true" focusable="false">
          {STERNE.map((eintrag, nummer) => <path d={stern(eintrag)} class:list={['buehne-stern', nummer % 3 === 0 && 'funkeln']} style={nummer % 3 === 0 ? `animation-delay: ${-nummer * 1.3}s` : undefined} />)}
          {PUNKTE.map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="buehne-punkt" />)}
        </svg>
        <Begleiterbild name="erzaehlerin" vorrang groessen={GROESSEN} klasse="buehne-figur buehne-links" />
        <Begleiterbild name="erzaehler" vorrang groessen={GROESSEN} klasse="buehne-figur buehne-rechts" />
      </div>
      <div class="titel-knoepfe">
        {store.oeffentlich ? (
          <Storeknopf sprache={sprache} ort="kopf" klasse="titel-store" hoehe={56} />
        ) : (
          <p class="titel-knopf titel-knopf-hell titel-bald">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
            <span>{kopf.bald}</span>
          </p>
        )}
        <a class="titel-knopf titel-knopf-rand" href={pfadVon('sogehts', sprache)}>
          <span>{kopf.anleitung}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
      <Text text={kopf.text} klasse="titel-absatz" />
    </div>
  </section>

  <section class="zahlen" aria-label={zahlen.aria}>
    <ul class="innen zahlen-liste">
      {zahlen.liste.map((eintrag) => (
        <li><span class="zahl">{eintrag.zahl}</span> <span class="zahl-text">{eintrag.text}</span></li>
      ))}
    </ul>
  </section>
</div>
