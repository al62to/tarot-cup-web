---
// Kopf der Startseite nach Entwurf 8.5 (design/reihe8/WebTitelbild.dc.html), Bühne 1280 x 640: links oben auf hellem
// Grund drei Originalkarten im Fächer (Rad −12°, Magier gerade, Ass der Kelche +12°) mit goldenem Rand, feine Kreise
// und zwei Sterne; die Diagonale mit Goldlinie; rechts unten auf Kaffeebraun die Tasse mit Dampf, Zeile, Überschrift
// und Knopf. Alle Maße der Bühne stehen in Einheiten des Entwurfs und wachsen mit der Breite (src/styles/start.css).
// Ab 64rem steht der Text wie im Entwurf auf der Bühne; darunter steht die Bühne ohne Text, Zeile, Überschrift und
// Knopf folgen auf Kaffeebraun. Am Handy (unter 30rem) hat die Bühne eine eigene, höhere Aufteilung (390 x 400), damit
// die Karten groß genug bleiben; die Diagonale bleibt. Reihenfolge wie in 7.1: Zeile, Überschrift (ein Satz je Zeile,
// Umbruch nur, wenn ein Satz allein zu lang ist), Absatz, Knopf; reicht der Text über die Bühne hinaus, wächst die
// Fläche nach unten mit. Ab 30rem liegen der helle Bereich und die Goldlinie über der ganzen Fensterbreite
// (titel-grund, titel-linie), damit die Diagonale auch bei Fenstern über 1280 Pixel bis an den Rand läuft.
// Knopf: Ist die App öffentlich, führt er zu Google Play; sonst steht „Bald bei Google Play“ als ruhiger Hinweis ohne
// Link.
import Kartenbild from './Kartenbild.astro';
import Text from './Text.astro';
import { TITELKARTEN } from '../daten/karten.mjs';
import { store, storeLink } from '../daten/seite.mjs';
import appDaten from '../daten/app_daten.json' with { type: 'json' };

const { sprache, kopf } = Astro.props;
const name = (id) => appDaten.karten.find((karte) => karte.id === id).name[sprache];
const jahr = sprache === 'de' ? 'Druck von 1909' : '1909 baskısı';
// Die Zeile steht in Großbuchstaben; „Android“ trägt lang="en", damit es auf Türkisch nicht zu „ANDROİD“ wird.
const zeileTeile = kopf.zeile.split(/(Android)/);
const stern = 'M0 -10 L2.5 -2.5 L10 0 L2.5 2.5 L0 10 L-2.5 2.5 L-10 0 L-2.5 -2.5 Z';
---
<section class="titel" aria-labelledby="titel-ueberschrift">
  <div class="titel-grund" aria-hidden="true"></div>
  <div class="titel-flaeche">
    <div class="titel-buehne">
      <div class="titel-hell" aria-hidden="true"></div>
      <svg class="titel-schmuck titel-breit" viewBox="0 0 1280 640" aria-hidden="true" focusable="false">
        <g class="titel-kreise"><circle cx="331" cy="206" r="256" /><circle cx="331" cy="206" r="228" stroke-dasharray="1 7" /><circle cx="331" cy="206" r="150" /></g>
        <g class="titel-sterne"><path d={stern} transform="translate(700 85)" /><path d={stern} transform="translate(50 420) scale(0.8)" /></g>
      </svg>
      <svg class="titel-schmuck titel-schmal" viewBox="0 0 390 400" aria-hidden="true" focusable="false">
        <g class="titel-kreise"><circle cx="142" cy="108.5" r="143" /><circle cx="142" cy="108.5" r="127" stroke-dasharray="1 5" /><circle cx="142" cy="108.5" r="84" /></g>
        <g class="titel-sterne"><path d={stern} transform="translate(338 40) scale(0.7)" /><path d={stern} transform="translate(26 312) scale(0.55)" /></g>
      </svg>
      {TITELKARTEN.map((id, nummer) => (
        <Kartenbild id={id} alt={`${name(id)}, ${jahr}`} klasse={`titel-karte titel-karte-${nummer + 1}`} laden="eager" vorrang={nummer === 1} groessen="(min-width: 64rem) 180px, (min-width: 30rem) 14vw, 26vw" />
      ))}
      <svg class="titel-diagonale titel-schmal" viewBox="0 0 390 400" aria-hidden="true" focusable="false"><path d="M393.2 117.7 L-3.2 402.3" /></svg>
      <svg class="titel-tasse" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path d="M42 30 Q37 23 42 16 Q47 9 42 2" class="titel-dampf" />
        <path d="M56 30 Q51 23 56 16 Q61 9 56 2" class="titel-dampf" />
        <path d="M22 36 H78 V48 A28 22 0 0 1 22 48 Z" fill="#F3EAD7" />
        <ellipse cx="50" cy="36" rx="28" ry="5" fill="#5A3A26" />
        <path d="M30 42 H70" stroke="#C9A86A" stroke-width="0.8" />
        <path d="M78 41 H84 A8.5 8.5 0 0 1 84 58 H76" fill="none" stroke="#F3EAD7" stroke-width="4.5" stroke-linecap="round" />
        <path d="M10 76 Q50 86 90 76" fill="none" stroke="#F3EAD7" stroke-width="4.5" stroke-linecap="round" />
      </svg>
    </div>
    <div class="titel-text">
      <p class="titel-zeile">{zeileTeile.map((teil) => (teil === 'Android' ? <span lang="en">{teil}</span> : <Text text={teil} ohne />))}</p>
      <h1 id="titel-ueberschrift">{kopf.zeilen.map((zeile) => <span class="titel-satz">{zeile}</span>)}</h1>
      <p class="titel-absatz">{kopf.text}</p>
      <div class="titel-knoepfe">
        {store.oeffentlich ? (
          <a class="knopf knopf-gold titel-knopf" href={storeLink('kopf')} rel="noopener">{kopf.knopf}</a>
        ) : (
          <p class="titel-bald">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="7" y="2.75" width="10" height="18.5" rx="2.25" /><path d="M11 18.2h2" /></svg>
            <span>{kopf.bald}</span>
          </p>
        )}
      </div>
    </div>
  </div>
  <div class="titel-linie" aria-hidden="true"></div>
</section>
