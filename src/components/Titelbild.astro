---
// Titelbild der Startseite nach Entwurf 9.1 (design/reihe9/WebNeu.dc.html), dazu das Zahlenband auf demselben dunklen
// Grund. Espresso mit leichter Körnung (eine kleine SVG-Kachel als Hintergrund, kein großes Bild) und warmem Licht.
// Links: Zeile, große Überschrift (Hervorhebung *…* aus den Textdaten kursiv in Gold), Absatz, „Bald bei Google Play“
// (Schalter store.oeffentlich: erst dann ein Link) und der Zweitknopf zur Anleitung.
// Rechts: zwei gefächerte Kartenrückseiten vor langsam drehenden goldenen Ringen, davor die Karte zum Umdrehen. Mit
// JavaScript wird sie zum Knopf: Antippen dreht sie um (3D-Drehung, bei reduzierter Bewegung ohne Drehung) und zeigt
// eine Originalkarte aus TITELKARTEN, zuerst den Magier; nochmal antippen dreht sie zurück, danach kommt die nächste.
// Darunter (aria-live) vorher der Tipp, danach Name und Hinweis aufs Lexikon. Keine Deutung, nichts wird gespeichert.
// Ohne JavaScript steht die Vorderseite des Magiers als Bild da, ohne Knopf und ohne Tipp.
import Betont from './Betont.astro';
import Kartenbild from './Kartenbild.astro';
import Text from './Text.astro';
import { GESPERRT, TITELKARTEN } from '../daten/karten.mjs';
import { store, storeLink } from '../daten/seite.mjs';
import { pfadVon } from '../daten/seiten.mjs';
import appDaten from '../daten/app_daten.json' with { type: 'json' };

const { sprache, kopf, zahlen } = Astro.props;
const name = (id) => appDaten.karten.find((karte) => karte.id === id).name[sprache];
const jahr = sprache === 'de' ? 'Druck von 1909' : '1909 baskısı';
// Zuerst der Magier, dann die übrigen Titelkarten; gesperrte Bilder nie (Kartenbild.astro prüft das zusätzlich).
const ERSTE = 'ta_01_magier';
const reihe = [ERSTE, ...TITELKARTEN.filter((id) => id !== ERSTE)].filter((id) => !GESPERRT.includes(id));
const karten = reihe.map((id) => ({ name: name(id), alt: `${name(id)}, ${jahr}`, klein: `/bilder/karten/${id}-240.webp`, gross: `/bilder/karten/${id}-480.webp` }));
// Die Zeile steht in Großbuchstaben; „Android“ trägt lang="en", damit es auf Türkisch nicht zu „ANDROİD“ wird.
const zeileTeile = kopf.zeile.split(/(Android)/);
---
<div class="titel-welt flaeche-dunkel">
  <section class="titel" aria-labelledby="titel-ueberschrift">
    <div class="innen titel-raster">
      <div class="titel-text">
        <p class="titel-zeile">{zeileTeile.map((teil) => (teil === 'Android' ? <span lang="en">{teil}</span> : <Text text={teil} ohne />))}</p>
        <h1 id="titel-ueberschrift">{kopf.zeilen.map((zeile) => <span class="titel-satz"><Betont text={zeile} /></span>)}</h1>
        <Text text={kopf.text} klasse="titel-absatz" />
        <div class="titel-knoepfe">
          {store.oeffentlich ? (
            <a class="titel-knopf titel-knopf-hell" href={storeLink('kopf')} rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
              <span>{kopf.knopf}</span>
            </a>
          ) : (
            <p class="titel-knopf titel-knopf-hell titel-bald">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
              <span>{kopf.bald}</span>
            </p>
          )}
          <a class="titel-knopf titel-knopf-rand" href={pfadVon('sogehts', sprache)}>
            <span>{kopf.anleitung}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>

      <div class="titel-karten">
        <div class="stapel">
          <div class="stapel-schein" aria-hidden="true"></div>
          <svg class="stapel-ringe" viewBox="0 0 420 420" aria-hidden="true" focusable="false">
            <circle cx="210" cy="210" r="200" /><circle cx="210" cy="210" r="180" stroke-dasharray="1 8" /><path d="M210 4v18M210 398v18M4 210h18M398 210h18" />
          </svg>
          <div class="stapel-hinten stapel-hinten-1" aria-hidden="true"></div>
          <div class="stapel-hinten stapel-hinten-2" aria-hidden="true"></div>
          <div
            class="wende"
            data-karte
            data-karten={JSON.stringify(karten)}
            data-tipp={kopf.karte.tipp}
            data-satz={kopf.karte.satz}
            data-umdrehen={kopf.karte.umdrehen}
            data-zurueck={kopf.karte.zurueck}
          >
            <span class="wende-dreh">
              <span class="wende-seite wende-rueck" aria-hidden="true">
                <svg viewBox="0 0 120 120" focusable="false"><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="44" stroke-dasharray="1 5" /><circle cx="60" cy="60" r="30" /><path d="M60 2v14M60 104v14M2 60h14M104 60h14" /><path d="M47 55h26v8a13 13 0 0 1-26 0z" /><path d="M73 57h3a4 4 0 0 1 0 8h-3" /></svg>
              </span>
              <span class="wende-seite wende-vorn">
                <Kartenbild id={ERSTE} alt={karten[0].alt} klasse="wende-bild" laden="eager" groessen="(min-width: 64rem) 220px, 48vw" />
              </span>
            </span>
          </div>
        </div>
        <p class="wende-text nur-js" aria-live="polite">
          <span class="wende-name" data-karte-name></span>
          <span class="wende-satz" data-karte-satz>{kopf.karte.tipp}</span>
        </p>
      </div>
    </div>
  </section>

  <section class="zahlen" aria-label={zahlen.aria}>
    <ul class="innen zahlen-liste">
      {zahlen.liste.map((eintrag) => (
        <li><span class="zahl">{eintrag.zahl}</span> <span class="zahl-text">{eintrag.text}</span></li>
      ))}
    </ul>
  </section>
</div>

<script>
  // Karte zum Umdrehen: Aus der Hülle wird ein echter Knopf (ohne JavaScript bleibt sie ein Bild). Der Zustand lebt
  // nur in der Klasse "offen" und im aria-label; nichts wird gespeichert.
  const huelle = document.querySelector('[data-karte]');
  if (huelle instanceof HTMLElement) {
    const angaben = { ...huelle.dataset };
    const karten = JSON.parse(angaben.karten ?? '[]');
    const knopf = document.createElement('button');
    knopf.type = 'button';
    knopf.className = huelle.className;
    knopf.append(...huelle.childNodes);
    huelle.replaceWith(knopf);
    const dreh = knopf.querySelector('.wende-dreh');
    const bild = knopf.querySelector('img');
    const name = document.querySelector('[data-karte-name]');
    const satz = document.querySelector('[data-karte-satz]');
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');
    let nummer = 0;
    let offen = false;
    let wechsel = false;
    // Nächste Karte einsetzen, sobald die Rückseite wieder vorn ist.
    const naechste = () => {
      if (!wechsel || !bild) return;
      wechsel = false;
      nummer = (nummer + 1) % karten.length;
      const karte = karten[nummer];
      bild.srcset = `${karte.klein} 240w, ${karte.gross} 480w`;
      bild.src = karte.gross;
      bild.alt = karte.alt;
    };
    const zeige = () => {
      const karte = karten[nummer];
      knopf.classList.toggle('offen', offen);
      knopf.setAttribute('aria-label', offen ? angaben.zurueck.replace('{name}', karte.name) : angaben.umdrehen);
      if (name) name.textContent = offen ? karte.name : '';
      if (satz) satz.textContent = offen ? angaben.satz : angaben.tipp;
    };
    dreh?.addEventListener('transitionend', (ereignis) => {
      if (ereignis.target === dreh && !offen) naechste();
    });
    knopf.addEventListener('click', () => {
      if (!offen && wechsel) naechste();
      offen = !offen;
      if (!offen) wechsel = true;
      zeige();
      if (!offen && (ruhig.matches || !dreh || getComputedStyle(dreh).transitionDuration === '0s')) naechste();
    });
    zeige();
  }
</script>
