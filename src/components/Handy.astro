---
// Ein Bildschirmfoto der App im Rahmen eines Handys (Muster Handy.astro von FoodAsu): dunkler Rand, runde Ecken,
// Schatten. "art": app (Store-Fotos, 1 : 2) oder sogehts (Emulator, 1 : 2,22). Breite und Höhe kommen aus den echten
// Maßen des Fotos (fotoMasse), der Rahmen folgt dem Seitenverhältnis des Bildes.
// "ohneRahmen": Das Bild ist kein Bildschirm (etwa das Teilen-Bild der App) und steht als Karte mit Schatten da.
// "bilder" (Schaukasten der Startseite): mehrere Fotos [{ name, alt }] im selben Rahmen; sichtbar ist nur das erste,
// die übrigen tragen hidden und laden erst, wenn ein Skript sie zeigt. "kennung": id des Rahmens (für aria-controls).
import { FOTO_BREITEN, fotoMasse, fotoPfad } from '../daten/fotos.mjs';

const { art, name, sprache, alt, bilder, kennung, groessen = '(min-width: 56rem) 240px, 60vw', laden = 'lazy', klasse, ohneRahmen = false } = Astro.props;
const liste = (bilder ?? [{ name, alt }]).map((bild) => {
  if (!bild.alt) throw new Error(`Handy: Alt-Text fehlt für ${art}/${bild.name} (${sprache})`);
  return { ...bild, ...fotoMasse(art, bild.name, sprache) };
});
---
<div class:list={[ohneRahmen ? 'bildkarte' : 'geraet', klasse]} id={kennung}>
  <div class={ohneRahmen ? 'bildkarte-rahmen' : 'geraet-rahmen'}>
    {liste.map((bild, nummer) => (
      <img
        src={fotoPfad(art, bild.name, sprache, 720)}
        srcset={FOTO_BREITEN.map((b) => `${fotoPfad(art, bild.name, sprache, b)} ${b}w`).join(', ')}
        sizes={groessen}
        alt={bild.alt}
        width={Math.round(bild.breite / 3)}
        height={Math.round(bild.hoehe / 3)}
        loading={nummer === 0 ? laden : 'lazy'}
        decoding="async"
        hidden={nummer > 0}
        data-bild={bilder ? nummer : undefined}
      />
    ))}
  </div>
</div>
