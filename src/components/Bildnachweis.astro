---
// Bildnachweis und Lizenzen: Kartenbilder von 1909 (wie der Bildnachweis der App), die beiden gezeichneten Figuren
// (seit AP-28), ihre Posen auf den Erklärseiten (AP-25; nur in Sprachen mit dem Text bildnachweis.posen und mit
// mindestens einer Erklärseite, AP-25A), Schriften der
// Website, Marke Google Play (nur, wenn das Abzeichen gezeigt wird).
import '../styles/dokument.css';
import Basis from '../layouts/Basis.astro';
import Text from './Text.astro';
import { oberflaeche } from '../daten/texte/oberflaeche.mjs';
import { store } from '../daten/seite.mjs';
import { wissenGruppen } from '../daten/wissen.mjs';

const { sprache } = Astro.props;
const T = oberflaeche[sprache].bildnachweis;
// Posen nur nennen, wo es Erklärseiten gibt, auf denen sie zu sehen sind.
const posen = wissenGruppen(sprache).length ? T.posen : null;
---
<Basis klasse="seite-recht seite-bildnachweis">
  <header class="seitenkopf innen schmal">
    <h1>{T.titel}</h1>
    <Text text={T.vorspann} klasse="vorspann" />
  </header>
  <div class="innen schmal dokument">
    {[T.karten, T.begleiter, posen, T.schriften].filter(Boolean).map((teil) => (
      <section>
        <h2>{teil.titel}</h2>
        {teil.absaetze.map((absatz) => <Text text={absatz} />)}
      </section>
    ))}
    {store.oeffentlich && <p>{T.marken}</p>}
  </div>
</Basis>
